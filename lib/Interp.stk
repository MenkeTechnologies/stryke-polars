package Polars::Interp

use Polars

## Interpolation cubic natural.
fn Polars::Interp::cubic_natural ($x, $y, $xnew) {
    Polars::_decode("interp_cubic_natural", polars__interp_cubic_natural(to_json({ x => $x, y => $y, xnew => $xnew })))->{y}
}

## Interpolation grid 2d.
fn Polars::Interp::grid_2d ($grid, $x, $y) {
    var %req = (grid => $grid)
    $req{x} = $x if defined $x
    $req{y} = $y if defined $y
    Polars::_decode("interp_grid_2d", polars__interp_grid_2d(to_json(\%req)))->{value}
}

