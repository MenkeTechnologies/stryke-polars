fn Polars::NdArray::convolve ($a, $v) {
    Polars::_decode("arr_convolve", polars__arr_convolve(to_json({ a => $a, v => $v })))->{array}
}

## Elementwise approx-equal mask. `$rtol` default 1e-5, `$atol` default 1e-8.
fn Polars::NdArray::isclose ($a, $b, $rtol, $atol) {
    my %req = (a => $a, b => $b)
    $req{rtol} = $rtol if defined $rtol
    $req{atol} = $atol if defined $atol
    Polars::_decode("arr_isclose", polars__arr_isclose(to_json(\%req)))->{array}
}

## Pearson correlation between two 1-D arrays.
fn Polars::NdArray::corrcoef ($a, $b) {
    Polars::_decode("arr_corrcoef", polars__arr_corrcoef(to_json({ a => $a, b => $b })))->{scalar}
}

## Sample covariance (ddof=1).
fn Polars::NdArray::cov ($a, $b) {
    Polars::_decode("arr_cov", polars__arr_cov(to_json({ a => $a, b => $b })))->{scalar}
}

## Histogram. Returns `{ counts, edges }`. `$n_bins` bins of uniform width.
fn Polars::NdArray::histogram ($arr, $n_bins) {
    Polars::_decode("arr_histogram", polars__arr_histogram(to_json({ array => $arr, n_bins => $n_bins })))
}

