## lib/NdArray.stk — `use Polars::NdArray`
##
## numpy ndarray surface (P4 slice). Wire format:
##   { data => [v1, v2, ...], shape => [d1, d2, ...] }   # row-major f64
##
## Constructors return `{ array => {...} }`; the wrappers below unwrap.

package Polars::NdArray

use Polars

## Build a zero-filled array of given shape arrayref.
fn Polars::NdArray::zeros ($shape) {
    Polars::_decode("arr_zeros", polars__arr_zeros(to_json({ shape => $shape })))->{array}
}

## Build a one-filled array.
fn Polars::NdArray::ones ($shape) {
    Polars::_decode("arr_ones", polars__arr_ones(to_json({ shape => $shape })))->{array}
}

## `numpy.arange(start, stop, step)` — 1-D.
fn Polars::NdArray::arange ($start, $stop, $step) {
    my %req = (stop => $stop)
    $req{start} = $start if defined $start
    $req{step} = $step if defined $step
    Polars::_decode("arr_arange", polars__arr_arange(to_json(\%req)))->{array}
}

## `numpy.linspace(start, stop, n)` — n evenly spaced incl. endpoints.
fn Polars::NdArray::linspace ($start, $stop, $n) {
    Polars::_decode("arr_linspace", polars__arr_linspace(to_json({ start => $start, stop => $stop, n => $n })))->{array}
}

## Reshape to new shape (must preserve total length).
fn Polars::NdArray::reshape ($arr, $shape) {
    Polars::_decode("arr_reshape", polars__arr_reshape(to_json({ array => $arr, shape => $shape })))->{array}
}

## Transpose (2-D only in this slice).
fn Polars::NdArray::transpose ($arr) {
    Polars::_decode("arr_transpose", polars__arr_transpose(to_json({ array => $arr })))->{array}
}

## Sum of all elements (scalar).
fn Polars::NdArray::sum  ($arr) { Polars::_decode("arr_sum",  polars__arr_sum (to_json({ array => $arr })))->{scalar} }
## Mean of all elements.
fn Polars::NdArray::mean ($arr) { Polars::_decode("arr_mean", polars__arr_mean(to_json({ array => $arr })))->{scalar} }
## Min of all elements.
fn Polars::NdArray::min  ($arr) { Polars::_decode("arr_min",  polars__arr_min (to_json({ array => $arr })))->{scalar} }
## Max of all elements.
fn Polars::NdArray::max  ($arr) { Polars::_decode("arr_max",  polars__arr_max (to_json({ array => $arr })))->{scalar} }

## Dot product (1-D arrays of equal length). Returns scalar.
fn Polars::NdArray::dot ($a, $b) {
    Polars::_decode("arr_dot", polars__arr_dot(to_json({ a => $a, b => $b })))->{scalar}
}

## Concatenate two arrays along `$axis` (default 0).
fn Polars::NdArray::concatenate ($a, $b, $axis) {
    my %req = (a => $a, b => $b)
    $req{axis} = $axis if defined $axis
    Polars::_decode("arr_concatenate", polars__arr_concatenate(to_json(\%req)))->{array}
}

## Identity matrix `n×n`.
fn Polars::NdArray::eye ($n) {
    Polars::_decode("arr_eye", polars__arr_eye(to_json({ n => $n })))->{array}
}
## Constant-fill array of given shape.
fn Polars::NdArray::full ($shape, $value) {
    Polars::_decode("arr_full", polars__arr_full(to_json({ shape => $shape, value => $value })))->{array}
}
## Index of minimum element (flat).
fn Polars::NdArray::argmin ($arr) {
    Polars::_decode("arr_argmin", polars__arr_argmin(to_json({ array => $arr })))->{index}
}
## Index of maximum element (flat).
fn Polars::NdArray::argmax ($arr) {
    Polars::_decode("arr_argmax", polars__arr_argmax(to_json({ array => $arr })))->{index}
}

## Any element non-zero?
fn Polars::NdArray::any ($arr) {
    Polars::_decode("arr_any", polars__arr_any(to_json({ array => $arr })))->{bool}
}
## All elements non-zero?
fn Polars::NdArray::all ($arr) {
    Polars::_decode("arr_all", polars__arr_all(to_json({ array => $arr })))->{bool}
}
## Count of non-zero elements.
fn Polars::NdArray::count_nonzero ($arr) {
    Polars::_decode("arr_count_nonzero", polars__arr_count_nonzero(to_json({ array => $arr })))->{count}
}
## Cumulative sum (1-D).
fn Polars::NdArray::cumsum ($arr) {
    Polars::_decode("arr_cumsum", polars__arr_cumsum(to_json({ array => $arr })))->{array}
}
## Sort ascending (1-D).
fn Polars::NdArray::sort ($arr) {
    Polars::_decode("arr_sort", polars__arr_sort(to_json({ array => $arr })))->{array}
}
## Indices that would sort (1-D). Returns array of indices.
fn Polars::NdArray::argsort ($arr) {
    Polars::_decode("arr_argsort", polars__arr_argsort(to_json({ array => $arr })))->{indices}
}
## Clip to `[$lower, $upper]`. Either bound optional.
fn Polars::NdArray::clip ($arr, $lower, $upper) {
    my %req = (array => $arr)
    $req{lower} = $lower if defined $lower
    $req{upper} = $upper if defined $upper
    Polars::_decode("arr_clip", polars__arr_clip(to_json(\%req)))->{array}
}
## First-order difference (1-D; output shorter by 1).
fn Polars::NdArray::diff ($arr) {
    Polars::_decode("arr_diff", polars__arr_diff(to_json({ array => $arr })))->{array}
}
## Sum along an axis (returns collapsed array).
fn Polars::NdArray::sum_axis ($arr, $axis) {
    Polars::_decode("arr_sum_axis", polars__arr_sum_axis(to_json({ array => $arr, axis => $axis })))->{array}
}
## Mean along an axis.
fn Polars::NdArray::mean_axis ($arr, $axis) {
    Polars::_decode("arr_mean_axis", polars__arr_mean_axis(to_json({ array => $arr, axis => $axis })))->{array}
}

## Horizontal stack (axis 0 for 1-D, axis 1 for 2-D).
fn Polars::NdArray::hstack ($a, $b) {
    Polars::_decode("arr_hstack", polars__arr_hstack(to_json({ a => $a, b => $b })))->{array}
}
## Vertical stack (axis 0).
fn Polars::NdArray::vstack ($a, $b) {
    Polars::_decode("arr_vstack", polars__arr_vstack(to_json({ a => $a, b => $b })))->{array}
}
## Tile (repeat whole array `$n` times along axis 0).
fn Polars::NdArray::tile ($arr, $n) {
    Polars::_decode("arr_tile", polars__arr_tile(to_json({ array => $arr, n => $n })))->{array}
}
## Unique sorted values (1-D).
fn Polars::NdArray::unique ($arr) {
    Polars::_decode("arr_unique", polars__arr_unique(to_json({ array => $arr })))->{array}
}

fn Polars::NdArray::prod     ($arr) { Polars::_decode("arr_prod",     polars__arr_prod    (to_json({ array => $arr })))->{scalar} }
fn Polars::NdArray::var      ($arr) { Polars::_decode("arr_var",      polars__arr_var     (to_json({ array => $arr })))->{scalar} }
fn Polars::NdArray::std      ($arr) { Polars::_decode("arr_std",      polars__arr_std     (to_json({ array => $arr })))->{scalar} }
fn Polars::NdArray::median   ($arr) { Polars::_decode("arr_median",   polars__arr_median  (to_json({ array => $arr })))->{scalar} }
fn Polars::NdArray::quantile ($arr, $q) { Polars::_decode("arr_quantile", polars__arr_quantile(to_json({ array => $arr, q => $q })))->{scalar} }
fn Polars::NdArray::max_axis ($arr, $axis) { Polars::_decode("arr_max_axis", polars__arr_max_axis(to_json({ array => $arr, axis => $axis })))->{array} }
fn Polars::NdArray::min_axis ($arr, $axis) { Polars::_decode("arr_min_axis", polars__arr_min_axis(to_json({ array => $arr, axis => $axis })))->{array} }

## Reverse the flat order (preserves shape).
fn Polars::NdArray::reverse ($arr) {
    Polars::_decode("arr_reverse", polars__arr_reverse(to_json({ array => $arr })))->{array}
}

## Repeat each element `$n` times in place (1-D).
fn Polars::NdArray::repeat ($arr, $n) {
    Polars::_decode("arr_repeat", polars__arr_repeat(to_json({ array => $arr, n => $n })))->{array}
}

fn Polars::NdArray::cumprod ($arr) { Polars::_decode("arr_cumprod", polars__arr_cumprod(to_json({ array => $arr })))->{array} }
fn Polars::NdArray::cummin  ($arr) { Polars::_decode("arr_cummin",  polars__arr_cummin (to_json({ array => $arr })))->{array} }
fn Polars::NdArray::cummax  ($arr) { Polars::_decode("arr_cummax",  polars__arr_cummax (to_json({ array => $arr })))->{array} }

## Split a 1-D array into `$n_parts` chunks. Returns arrayref of arrays.
fn Polars::NdArray::split ($arr, $n_parts) {
    Polars::_decode("arr_split", polars__arr_split(to_json({ array => $arr, n_parts => $n_parts })))->{chunks}
}

## `np.meshgrid(x, y)` — returns `{ x, y }` (each a 2-D array `(ny, nx)`).
fn Polars::NdArray::meshgrid ($x, $y) {
    Polars::_decode("arr_meshgrid", polars__arr_meshgrid(to_json({ x => $x, y => $y })))
}

## `np.zeros_like(array)`.
fn Polars::NdArray::zeros_like ($arr) {
    Polars::_decode("arr_zeros_like", polars__arr_zeros_like(to_json({ array => $arr })))->{array}
}
## `np.ones_like(array)`.
fn Polars::NdArray::ones_like ($arr) {
    Polars::_decode("arr_ones_like", polars__arr_ones_like(to_json({ array => $arr })))->{array}
}
## `np.full_like(array, value)`.
fn Polars::NdArray::full_like ($arr, $value) {
    Polars::_decode("arr_full_like", polars__arr_full_like(to_json({ array => $arr, value => $value })))->{array}
}
## Normalize so elements sum to 1.
fn Polars::NdArray::normalize ($arr) {
    Polars::_decode("arr_normalize", polars__arr_normalize(to_json({ array => $arr })))->{array}
}
## `np.logspace(start, stop, n, base=10)` — log-spaced 1-D array.
fn Polars::NdArray::logspace ($start, $stop, $n, $base) {
    my %req = (start => $start, stop => $stop, n => $n)
    $req{base} = $base if defined $base
    Polars::_decode("arr_logspace", polars__arr_logspace(to_json(\%req)))->{array}
}

## Extract diagonal of a 2-D array (1-D array, length min(rows, cols)).
fn Polars::NdArray::diagonal ($arr) {
    Polars::_decode("arr_diagonal", polars__arr_diagonal(to_json({ array => $arr })))->{array}
}

## `np.trace(a)` — sum of the diagonal of a 2-D array.
fn Polars::NdArray::trace ($arr) {
    Polars::_decode("arr_trace", polars__arr_trace(to_json({ array => $arr })))->{scalar}
}

## Roll elements of a 1-D array by `$shift` positions (positive = right).
fn Polars::NdArray::roll ($arr, $shift) {
    Polars::_decode("arr_roll", polars__arr_roll(to_json({ array => $arr, shift => $shift })))->{array}
}

## Flatten any-D array to 1-D.
fn Polars::NdArray::flatten ($arr) {
    Polars::_decode("arr_flatten", polars__arr_flatten(to_json({ array => $arr })))->{array}
}

## `np.squeeze(a)` — drop length-1 dims.
fn Polars::NdArray::squeeze ($arr) {
    Polars::_decode("arr_squeeze", polars__arr_squeeze(to_json({ array => $arr })))->{array}
}

