## `np.trapezoid(y, dx=1)` — trapezoidal integration scalar.
fn Polars::NdArray::trapezoid ($arr, $dx) {
    my %req = (array => $arr)
    $req{dx} = $dx if defined $dx
    Polars::_decode("arr_trapezoid", polars__arr_trapezoid(to_json(\%req)))->{scalar}
}

