## `np.clip(a, lo, hi)` — scalar bounds applied elementwise.
fn Polars::Ufunc::clip ($arr, $lower, $upper) {
    var %req = (array => $arr)
    $req{lower} = $lower if defined $lower
    $req{upper} = $upper if defined $upper
    Polars::_decode("np_clip", polars__np_clip(to_json(\%req)))->{array}
}

## `np.where(cond, a, b)` — elementwise; cond non-zero ⇒ a, else b.
fn Polars::Ufunc::where ($cond, $a, $b) {
    Polars::_decode("np_where", polars__np_where(to_json({ cond => $cond, a => $a, b => $b })))->{array}
}

fn Polars::Ufunc::remainder ($a, $b) { Polars::_decode("np_remainder", polars__np_remainder(to_json({ a => $a, b => $b })))->{array} }
fn Polars::Ufunc::fmax      ($a, $b) { Polars::_decode("np_fmax",      polars__np_fmax     (to_json({ a => $a, b => $b })))->{array} }
fn Polars::Ufunc::fmin      ($a, $b) { Polars::_decode("np_fmin",      polars__np_fmin     (to_json({ a => $a, b => $b })))->{array} }
fn Polars::Ufunc::heaviside ($x, $h0) { Polars::_decode("np_heaviside", polars__np_heaviside(to_json({ a => $x, b => $h0 })))->{array} }

fn Polars::Ufunc::sinc    ($arr) { Polars::_decode("np_sinc",    polars__np_sinc   (to_json({ array => $arr })))->{array} }
fn Polars::Ufunc::signbit ($arr) { Polars::_decode("np_signbit", polars__np_signbit(to_json({ array => $arr })))->{array} }
