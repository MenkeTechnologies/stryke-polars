fn Polars::Ufunc::rad2deg ($arr) { Polars::_decode("np_rad2deg", polars__np_rad2deg(to_json({ array => $arr })))->{array} }

## `np.modf(x)` — splits each element into `{ frac, int }`.
fn Polars::Ufunc::modf ($arr) {
    Polars::_decode("np_modf", polars__np_modf(to_json({ array => $arr })))
}

## `np.logaddexp(a, b)` — numerically stable log(exp(a) + exp(b)).
fn Polars::Ufunc::logaddexp ($a, $b) {
    Polars::_decode("np_logaddexp", polars__np_logaddexp(to_json({ a => $a, b => $b })))->{array}
}

## `np.logaddexp2(a, b)` — base-2 variant.
fn Polars::Ufunc::logaddexp2 ($a, $b) {
    Polars::_decode("np_logaddexp2", polars__np_logaddexp2(to_json({ a => $a, b => $b })))->{array}
}

## `np.select(conditions, choices, default)` — first matching condition wins.
fn Polars::Ufunc::select ($conditions, $choices, $default) {
    var %req = (conditions => $conditions, choices => $choices)
    $req{default} = $default if defined $default
    Polars::_decode("np_select", polars__np_select(to_json(\%req)))->{array}
}

fn Polars::Ufunc::fix    ($arr) { Polars::_decode("np_fix",    polars__np_fix   (to_json({ array => $arr })))->{array} }
fn Polars::Ufunc::around ($arr, $decimals) {
    var %req = (array => $arr)
    $req{decimals} = $decimals if defined $decimals
    Polars::_decode("np_around", polars__np_around(to_json(\%req)))->{array}
}

## `np.positive(a)` — identity (mirror of np.negative).
fn Polars::Ufunc::positive ($arr) {
    Polars::_decode("np_positive", polars__np_positive(to_json({ array => $arr })))->{array}
}

# ── scalar-broadcast ────────────────────────────────────────────────

fn Polars::Ufunc::add_scalar      ($arr, $scalar) { Polars::_decode("np_add_scalar",      polars__np_add_scalar     (to_json({ array => $arr, scalar => $scalar })))->{array} }
fn Polars::Ufunc::subtract_scalar ($arr, $scalar) { Polars::_decode("np_subtract_scalar", polars__np_subtract_scalar(to_json({ array => $arr, scalar => $scalar })))->{array} }
fn Polars::Ufunc::multiply_scalar ($arr, $scalar) { Polars::_decode("np_multiply_scalar", polars__np_multiply_scalar(to_json({ array => $arr, scalar => $scalar })))->{array} }
fn Polars::Ufunc::divide_scalar   ($arr, $scalar) { Polars::_decode("np_divide_scalar",   polars__np_divide_scalar  (to_json({ array => $arr, scalar => $scalar })))->{array} }
fn Polars::Ufunc::power_scalar    ($arr, $scalar) { Polars::_decode("np_power_scalar",    polars__np_power_scalar   (to_json({ array => $arr, scalar => $scalar })))->{array} }
