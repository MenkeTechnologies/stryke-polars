## lib/Sparse.stk — `use Polars::Sparse`
##
## Wrappers around the cdylib `polars__*` exports for the `sparse_*` family.
## Auto-generated from src/*.rs sources — args, return keys, and docstrings
## come straight from the Rust definitions.

package Polars::Sparse

use Polars

## Sparse matrix add.
fn Polars::Sparse::add ($a, $b) {
    Polars::_decode("sparse_add", polars__sparse_add(to_json({ a => $a, b => $b })))->{sparse}
}

## Sparse matrix subtract (a - b). Same-shape required; cancelled entries drop.
fn Polars::Sparse::sub ($a, $b) {
    Polars::_decode("sparse_sub", polars__sparse_sub(to_json({ a => $a, b => $b })))->{sparse}
}

## Sparse matrix-matrix multiply (a . b). Requires a.n_cols == b.n_rows; the
## result is a.n_rows x b.n_cols. Computed coordinate-wise, cancelled entries
## drop.
fn Polars::Sparse::mat_mul ($a, $b) {
    Polars::_decode("sparse_mat_mul", polars__sparse_mat_mul(to_json({ a => $a, b => $b })))->{sparse}
}

## Sparse element-wise (Hadamard) product a ∘ b. Same shape required; an entry
## survives only where BOTH inputs are non-zero. Distinct from mat_mul.
fn Polars::Sparse::hadamard ($a, $b) {
    Polars::_decode("sparse_hadamard", polars__sparse_hadamard(to_json({ a => $a, b => $b })))->{sparse}
}

## Sparse matrix density.
fn Polars::Sparse::density ($sparse) {
    Polars::_decode("sparse_density", polars__sparse_density(to_json({ sparse => $sparse })))->{density}
}

## Sparse matrix diagonal.
fn Polars::Sparse::diagonal ($sparse) {
    Polars::_decode("sparse_diagonal", polars__sparse_diagonal(to_json({ sparse => $sparse })))->{array}
}

## Sparse matrix eye.
fn Polars::Sparse::eye ($n) {
    Polars::_decode("sparse_eye", polars__sparse_eye(to_json({ n => $n })))->{sparse}
}

## Frobenius norm: sqrt of the sum of squared entries. eye(n) → sqrt(n).
fn Polars::Sparse::frobenius ($sparse) {
    Polars::_decode("sparse_frobenius", polars__sparse_frobenius(to_json({ sparse => $sparse })))->{norm}
}

## Sparse matrix from dense.
fn Polars::Sparse::from_dense ($matrix) {
    Polars::_decode("sparse_from_dense", polars__sparse_from_dense(to_json({ matrix => $matrix })))->{sparse}
}

## Sparse matrix mul vec.
fn Polars::Sparse::mul_vec ($vector, $sparse) {
    Polars::_decode("sparse_mul_vec", polars__sparse_mul_vec(to_json({ vector => $vector, sparse => $sparse })))->{array}
}

## Sparse matrix nnz.
fn Polars::Sparse::nnz ($sparse) {
    Polars::_decode("sparse_nnz", polars__sparse_nnz(to_json({ sparse => $sparse })))->{nnz}
}

## Sparse matrix scale.
fn Polars::Sparse::scale ($sparse, $alpha) {
    var %req = (sparse => $sparse)
    $req{alpha} = $alpha if defined $alpha
    Polars::_decode("sparse_scale", polars__sparse_scale(to_json(\%req)))->{sparse}
}

## Sparse matrix to dense.
fn Polars::Sparse::to_dense ($sparse) {
    Polars::_decode("sparse_to_dense", polars__sparse_to_dense(to_json({ sparse => $sparse })))->{array}
}

## Sparse matrix trace.
fn Polars::Sparse::trace ($sparse) {
    Polars::_decode("sparse_trace", polars__sparse_trace(to_json({ sparse => $sparse })))->{trace}
}

## Sparse matrix transpose.
fn Polars::Sparse::transpose ($sparse) {
