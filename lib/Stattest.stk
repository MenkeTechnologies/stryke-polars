package Polars::Stattest

use Polars

## Statistical test acf.
fn Polars::Stattest::acf ($a, $max_lag) {
    var %req = (a => $a)
    $req{max_lag} = $max_lag if defined $max_lag
    Polars::_decode("stattest_acf", polars__stattest_acf(to_json(\%req)))->{acf}
}

