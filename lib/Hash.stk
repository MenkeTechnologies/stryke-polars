package Polars::Hash

use Polars

## Hash ap — Arash Partow alternating odd/even mixing hash (seed 0xAAAAAAAA).
fn Polars::Hash::ap ($value) {
    Polars::_decode("hash_ap", polars__hash_ap(to_json({ value => $value })))->{hash}
}

## Hash bkdr — Kernighan & Ritchie hash (seed 131, h = h*131 + c).
fn Polars::Hash::bkdr ($value) {
    Polars::_decode("hash_bkdr", polars__hash_bkdr(to_json({ value => $value })))->{hash}
}

