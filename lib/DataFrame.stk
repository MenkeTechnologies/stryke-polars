## lib/DataFrame.stk — `use Polars::DataFrame`
##
## pandas DataFrame surface (P1.1 slice).
##
## Wire format: columnar `{col1 => [v1, v2, ...], col2 => [...], ...}`. The
## cdylib canonicalizes dtypes on the round trip — pass any hash-of-arrays
## shape and read back the polars-inferred typing.

package Polars::DataFrame

use Polars

# ── round-trip ───────────────────────────────────────────────────────

## Construct a canonical DataFrame envelope from columnar input.
## Returns `{ frame, shape => [nrows, ncols], dtypes => [str, ...] }`.
fn Polars::DataFrame::new ($cols) {
    Polars::_decode("df_new", polars__df_new(to_json({ frame => $cols })))
}

# ── readers ──────────────────────────────────────────────────────────

## First `$n` rows (default 5). Returns `{ frame }`.
fn Polars::DataFrame::head ($cols, $n) {
    my %req = (frame => $cols)
    $req{n} = $n if defined $n
    Polars::_decode("df_head", polars__df_head(to_json(\%req)))->{frame}
}

## Last `$n` rows (default 5). Returns `{ frame }`.
fn Polars::DataFrame::tail ($cols, $n) {
    my %req = (frame => $cols)
    $req{n} = $n if defined $n
    Polars::_decode("df_tail", polars__df_tail(to_json(\%req)))->{frame}
}

## `[nrows, ncols]`.
fn Polars::DataFrame::shape ($cols) {
    Polars::_decode("df_shape", polars__df_shape(to_json({ frame => $cols })))->{shape}
}

## Column names.
fn Polars::DataFrame::columns ($cols) {
    Polars::_decode("df_columns", polars__df_columns(to_json({ frame => $cols })))->{columns}
}

## Per-column dtype as polars Display string (`i64`, `f64`, `str`, `bool`, …).
fn Polars::DataFrame::dtypes ($cols) {
    Polars::_decode("df_dtypes", polars__df_dtypes(to_json({ frame => $cols })))->{dtypes}
}

# ── projection ───────────────────────────────────────────────────────

## Column subset in declared order. Returns the projected frame.
fn Polars::DataFrame::select ($cols, $names) {
    my $r = Polars::_decode("df_select", polars__df_select(to_json({ frame => $cols, columns => $names })))
    $r->{frame}
}

## Round-trip through polars' canonical columnar form (dtype inference).
fn Polars::DataFrame::to_json ($cols) {
    Polars::_decode("df_to_json", polars__df_to_json(to_json({ frame => $cols })))->{frame}
}

# ── structure ────────────────────────────────────────────────────────

# Note: `Polars::DataFrame::describe` deferred — polars 0.45 doesn't expose
# `describe` as a DataFrame method even with the `describe` feature. Lands
# in a later slice hand-rolled from per-stat aggregations.

## Drop columns by name. `$names` is an arrayref of column names.
fn Polars::DataFrame::drop ($cols, $names) {
    Polars::_decode("df_drop", polars__df_drop(to_json({ frame => $cols, columns => $names })))->{frame}
}

## Rename columns. `$mapping` is a hashref `{ old => new, ... }`.
fn Polars::DataFrame::rename ($cols, $mapping) {
    Polars::_decode("df_rename", polars__df_rename(to_json({ frame => $cols, mapping => $mapping })))->{frame}
}

## Sort by `$by` (arrayref of column names). `$descending` is either
## undef (default ascending), a single bool (applied to every key), or
## an arrayref of bools per key.
fn Polars::DataFrame::sort ($cols, $by, $descending) {
    my %req = (frame => $cols, by => $by)
    $req{descending} = $descending if defined $descending
    Polars::_decode("df_sort", polars__df_sort(to_json(\%req)))->{frame}
}

# ── filter ───────────────────────────────────────────────────────────

## Rows where `column > value` (numeric/string/bool).
fn Polars::DataFrame::filter_gt ($cols, $column, $value) {
    Polars::_decode("df_filter_gt", polars__df_filter_gt(to_json({ frame => $cols, column => $column, value => $value })))->{frame}
}

## Rows where `column < value`.
fn Polars::DataFrame::filter_lt ($cols, $column, $value) {
    Polars::_decode("df_filter_lt", polars__df_filter_lt(to_json({ frame => $cols, column => $column, value => $value })))->{frame}
}

## Rows where `column == value`.
fn Polars::DataFrame::filter_eq ($cols, $column, $value) {
    Polars::_decode("df_filter_eq", polars__df_filter_eq(to_json({ frame => $cols, column => $column, value => $value })))->{frame}
}

# ── P1.2: per-column aggregations ───────────────────────────────────

fn Polars::DataFrame::sum    ($cols) { Polars::_decode("df_sum",    polars__df_sum(to_json({ frame => $cols })))->{frame} }
fn Polars::DataFrame::mean   ($cols) { Polars::_decode("df_mean",   polars__df_mean(to_json({ frame => $cols })))->{frame} }
fn Polars::DataFrame::median ($cols) { Polars::_decode("df_median", polars__df_median(to_json({ frame => $cols })))->{frame} }
fn Polars::DataFrame::min    ($cols) { Polars::_decode("df_min",    polars__df_min(to_json({ frame => $cols })))->{frame} }
fn Polars::DataFrame::max    ($cols) { Polars::_decode("df_max",    polars__df_max(to_json({ frame => $cols })))->{frame} }
fn Polars::DataFrame::count  ($cols) { Polars::_decode("df_count",  polars__df_count(to_json({ frame => $cols })))->{frame} }

## Std/Var optional `$ddof` (default 1).
fn Polars::DataFrame::std ($cols, $ddof) {
    my %req = (frame => $cols)
    $req{ddof} = $ddof if defined $ddof
    Polars::_decode("df_std", polars__df_std(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::var ($cols, $ddof) {
    my %req = (frame => $cols)
    $req{ddof} = $ddof if defined $ddof
    Polars::_decode("df_var", polars__df_var(to_json(\%req)))->{frame}
}

## Per-column quantile. `$q` in [0, 1].
fn Polars::DataFrame::quantile ($cols, $q) {
    Polars::_decode("df_quantile", polars__df_quantile(to_json({ frame => $cols, q => $q })))->{frame}
}

## Per-column distinct-value count. Returns `{ col => n, ... }`.
fn Polars::DataFrame::nunique ($cols) {
    Polars::_decode("df_nunique", polars__df_nunique(to_json({ frame => $cols })))->{counts}
}

# ── P1.2b: cumulative ───────────────────────────────────────────────

## Cumulative ops. Optional `$columns` arrayref restricts which columns.
fn Polars::DataFrame::cumsum  ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_cumsum", polars__df_cumsum(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::cumprod ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_cumprod", polars__df_cumprod(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::cummin  ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_cummin", polars__df_cummin(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::cummax  ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_cummax", polars__df_cummax(to_json(\%req)))->{frame}
}

