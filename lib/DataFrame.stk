    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_abs", polars__df_abs(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::sqrt  ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_sqrt", polars__df_sqrt(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::exp   ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_exp", polars__df_exp(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::log   ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_log", polars__df_log(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::floor ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_floor", polars__df_floor(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::ceil  ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_ceil", polars__df_ceil(to_json(\%req)))->{frame}
}
## Round each column to `$decimals` places (default 0).
fn Polars::DataFrame::round ($cols, $decimals, $columns) {
    my %req = (frame => $cols)
    $req{decimals} = $decimals if defined $decimals
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_round", polars__df_round(to_json(\%req)))->{frame}
}

# ── P1.4: missing / null ────────────────────────────────────────────

## Fill all nulls with `$value` (numeric/string/bool).
fn Polars::DataFrame::fill_null ($cols, $value) {
    Polars::_decode("df_fill_null", polars__df_fill_null(to_json({ frame => $cols, value => $value })))->{frame}
}

## Drop rows where any (or `$subset`) column is null.
fn Polars::DataFrame::drop_nulls ($cols, $subset) {
    my %req = (frame => $cols)
    $req{subset} = $subset if defined $subset
    Polars::_decode("df_drop_nulls", polars__df_drop_nulls(to_json(\%req)))->{frame}
}

## Per-column null mask (true where null).
fn Polars::DataFrame::is_null ($cols) {
    Polars::_decode("df_is_null", polars__df_is_null(to_json({ frame => $cols })))->{frame}
}

## Per-column not-null mask.
fn Polars::DataFrame::is_not_null ($cols) {
    Polars::_decode("df_is_not_null", polars__df_is_not_null(to_json({ frame => $cols })))->{frame}
}

# ── P1.4b: unique / counts ──────────────────────────────────────────

## Distinct rows. Optional `$subset` restricts which columns determine uniqueness.
fn Polars::DataFrame::unique ($cols, $subset) {
    my %req = (frame => $cols)
    $req{subset} = $subset if defined $subset
    Polars::_decode("df_unique", polars__df_unique(to_json(\%req)))->{frame}
}

## pandas `Series.value_counts` for a single `$column`.
fn Polars::DataFrame::value_counts ($cols, $column) {
    Polars::_decode("df_value_counts", polars__df_value_counts(to_json({ frame => $cols, column => $column })))->{frame}
}

# ── P1.3: joins ─────────────────────────────────────────────────────

## Joins. `$right` is the RHS frame; `$lkeys`/`$rkeys` are key-name arrayrefs.
fn Polars::DataFrame::inner_join ($left, $right, $lkeys, $rkeys) {
    Polars::_decode("df_inner_join", polars__df_inner_join(to_json({ frame => $left, right => $right, left_on => $lkeys, right_on => $rkeys })))->{frame}
}
fn Polars::DataFrame::left_join ($left, $right, $lkeys, $rkeys) {
    Polars::_decode("df_left_join", polars__df_left_join(to_json({ frame => $left, right => $right, left_on => $lkeys, right_on => $rkeys })))->{frame}
}
fn Polars::DataFrame::full_join ($left, $right, $lkeys, $rkeys) {
    Polars::_decode("df_full_join", polars__df_full_join(to_json({ frame => $left, right => $right, left_on => $lkeys, right_on => $rkeys })))->{frame}
}
## Cross join — keys ignored, cartesian product.
fn Polars::DataFrame::cross_join ($left, $right) {
    Polars::_decode("df_cross_join", polars__df_cross_join(to_json({ frame => $left, right => $right })))->{frame}
}
fn Polars::DataFrame::semi_join ($left, $right, $lkeys, $rkeys) {
    Polars::_decode("df_semi_join", polars__df_semi_join(to_json({ frame => $left, right => $right, left_on => $lkeys, right_on => $rkeys })))->{frame}
}
fn Polars::DataFrame::anti_join ($left, $right, $lkeys, $rkeys) {
    Polars::_decode("df_anti_join", polars__df_anti_join(to_json({ frame => $left, right => $right, left_on => $lkeys, right_on => $rkeys })))->{frame}
}

## Vertically stack two frames (must share schema).
fn Polars::DataFrame::concat ($left, $right) {
    Polars::_decode("df_concat", polars__df_concat(to_json({ frame => $left, right => $right })))->{frame}
}

# ── P1.5a: window ───────────────────────────────────────────────────

## Shift every column by `$n` rows (negative = past, positive = future).
fn Polars::DataFrame::shift ($cols, $n, $columns) {
    my %req = (frame => $cols)
    $req{n} = $n if defined $n
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_shift", polars__df_shift(to_json(\%req)))->{frame}
}
## First-order difference per column.
fn Polars::DataFrame::diff ($cols, $n, $columns) {
    my %req = (frame => $cols)
    $req{n} = $n if defined $n
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_diff", polars__df_diff(to_json(\%req)))->{frame}
}
## Percent change per column.
fn Polars::DataFrame::pct_change ($cols, $n, $columns) {
    my %req = (frame => $cols)
    $req{n} = $n if defined $n
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_pct_change", polars__df_pct_change(to_json(\%req)))->{frame}
}
## Per-column rank (average method, ascending).
fn Polars::DataFrame::rank ($cols, $columns) {
    my %req = (frame => $cols)
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rank", polars__df_rank(to_json(\%req)))->{frame}
}
## Clip into `[lower, upper]`. Provide at least one bound.
fn Polars::DataFrame::clip ($cols, $lower, $upper, $columns) {
    my %req = (frame => $cols)
    $req{lower} = $lower if defined $lower
    $req{upper} = $upper if defined $upper
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_clip", polars__df_clip(to_json(\%req)))->{frame}
}

# ── P1.5b: groupby ──────────────────────────────────────────────────

## Group-by aggregations. `$by` is an arrayref of key columns. The agg is
## applied to every column NOT in `$by`.
fn Polars::DataFrame::groupby_sum    ($cols, $by) { Polars::_decode("df_groupby_sum",    polars__df_groupby_sum   (to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_mean   ($cols, $by) { Polars::_decode("df_groupby_mean",   polars__df_groupby_mean  (to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_median ($cols, $by) { Polars::_decode("df_groupby_median", polars__df_groupby_median(to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_min    ($cols, $by) { Polars::_decode("df_groupby_min",    polars__df_groupby_min   (to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_max    ($cols, $by) { Polars::_decode("df_groupby_max",    polars__df_groupby_max   (to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_std    ($cols, $by) { Polars::_decode("df_groupby_std",    polars__df_groupby_std   (to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_var    ($cols, $by) { Polars::_decode("df_groupby_var",    polars__df_groupby_var   (to_json({ frame => $cols, by => $by })))->{frame} }
fn Polars::DataFrame::groupby_count  ($cols, $by) { Polars::_decode("df_groupby_count",  polars__df_groupby_count (to_json({ frame => $cols, by => $by })))->{frame} }

# ── P1.5b: rolling ──────────────────────────────────────────────────

## Rolling-window aggregations. `$window` ≥ 1; `$min_periods` defaults to
## `$window`; `$columns` arrayref restricts which columns get the op.
fn Polars::DataFrame::rolling_sum  ($cols, $window, $min_periods, $columns) {
    my %req = (frame => $cols, window => $window)
    $req{min_periods} = $min_periods if defined $min_periods
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rolling_sum", polars__df_rolling_sum(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::rolling_mean ($cols, $window, $min_periods, $columns) {
    my %req = (frame => $cols, window => $window)
    $req{min_periods} = $min_periods if defined $min_periods
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rolling_mean", polars__df_rolling_mean(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::rolling_min  ($cols, $window, $min_periods, $columns) {
    my %req = (frame => $cols, window => $window)
    $req{min_periods} = $min_periods if defined $min_periods
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rolling_min", polars__df_rolling_min(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::rolling_max  ($cols, $window, $min_periods, $columns) {
    my %req = (frame => $cols, window => $window)
    $req{min_periods} = $min_periods if defined $min_periods
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rolling_max", polars__df_rolling_max(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::rolling_std  ($cols, $window, $min_periods, $columns) {
    my %req = (frame => $cols, window => $window)
    $req{min_periods} = $min_periods if defined $min_periods
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rolling_std", polars__df_rolling_std(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::rolling_var  ($cols, $window, $min_periods, $columns) {
    my %req = (frame => $cols, window => $window)
    $req{min_periods} = $min_periods if defined $min_periods
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_rolling_var", polars__df_rolling_var(to_json(\%req)))->{frame}
}

# ── P1.5b: ewm ──────────────────────────────────────────────────────

# ── P1.5d: between / coalesce / explode ─────────────────────────────

fn Polars::DataFrame::filter_between ($cols, $column, $lower, $upper) {
    Polars::_decode("df_filter_between", polars__df_filter_between(to_json({ frame => $cols, column => $column, lower => $lower, upper => $upper })))->{frame}
}
fn Polars::DataFrame::coalesce ($cols, $columns, $as_name) {
    my %req = (frame => $cols, columns => $columns)
    $req{as_name} = $as_name if defined $as_name
    Polars::_decode("df_coalesce", polars__df_coalesce(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::explode ($cols, $columns) {
    Polars::_decode("df_explode", polars__df_explode(to_json({ frame => $cols, columns => $columns })))->{frame}
}

# ── P3: string accessor ─────────────────────────────────────────────

fn Polars::DataFrame::str_to_upper  ($cols, $column) { Polars::_decode("str_to_upper",  polars__str_to_upper (to_json({ frame => $cols, column => $column })))->{frame} }
fn Polars::DataFrame::str_to_lower  ($cols, $column) { Polars::_decode("str_to_lower",  polars__str_to_lower (to_json({ frame => $cols, column => $column })))->{frame} }
fn Polars::DataFrame::str_len       ($cols, $column) { Polars::_decode("str_len",       polars__str_len      (to_json({ frame => $cols, column => $column })))->{frame} }
fn Polars::DataFrame::str_strip     ($cols, $column) { Polars::_decode("str_strip",     polars__str_strip    (to_json({ frame => $cols, column => $column })))->{frame} }
fn Polars::DataFrame::str_contains  ($cols, $column, $pattern, $literal) {
    my %req = (frame => $cols, column => $column, pattern => $pattern)
    $req{literal} = $literal if defined $literal
    Polars::_decode("str_contains", polars__str_contains(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::str_starts_with ($cols, $column, $pattern) {
