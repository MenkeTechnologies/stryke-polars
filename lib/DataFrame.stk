fn Polars::DataFrame::dt_second  ($cols, $column) { Polars::_decode("dt_second",  polars__dt_second (to_json({ frame => $cols, column => $column })))->{frame} }
fn Polars::DataFrame::dt_weekday    ($cols, $column) { Polars::_decode("dt_weekday",    polars__dt_weekday   (to_json({ frame => $cols, column => $column })))->{frame} }
fn Polars::DataFrame::dt_quarter    ($cols, $column) { Polars::_decode("dt_quarter",    polars__dt_quarter   (to_json({ frame => $cols, column => $column })))->{frame} }
