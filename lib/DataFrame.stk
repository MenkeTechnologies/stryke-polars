}
fn Polars::DataFrame::str_ends_with ($cols, $column, $pattern) {
    Polars::_decode("str_ends_with", polars__str_ends_with(to_json({ frame => $cols, column => $column, pattern => $pattern })))->{frame}
}
fn Polars::DataFrame::str_replace_all ($cols, $column, $pattern, $replacement, $literal) {
    my %req = (frame => $cols, column => $column, pattern => $pattern, replacement => $replacement)
    $req{literal} = $literal if defined $literal
