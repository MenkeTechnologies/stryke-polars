fn Polars::DataFrame::str_pad_start ($cols, $column, $length, $fill) {
    my %req = (frame => $cols, column => $column, length => $length)
    $req{fill} = $fill if defined $fill
    Polars::_decode("str_pad_start", polars__str_pad_start(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::str_pad_end ($cols, $column, $length, $fill) {
    my %req = (frame => $cols, column => $column, length => $length)
    $req{fill} = $fill if defined $fill
    Polars::_decode("str_pad_end", polars__str_pad_end(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::str_slice ($cols, $column, $start, $length) {
    my %req = (frame => $cols, column => $column, start => $start)
    $req{length} = $length if defined $length
    Polars::_decode("str_slice", polars__str_slice(to_json(\%req)))->{frame}
}

fn Polars::DataFrame::str_reverse ($cols, $column) {
    Polars::_decode("str_reverse", polars__str_reverse(to_json({ frame => $cols, column => $column })))->{frame}
}
fn Polars::DataFrame::str_head ($cols, $column, $n) {
    Polars::_decode("str_head", polars__str_head(to_json({ frame => $cols, column => $column, n => $n })))->{frame}
}
fn Polars::DataFrame::str_tail ($cols, $column, $n) {
    Polars::_decode("str_tail", polars__str_tail(to_json({ frame => $cols, column => $column, n => $n })))->{frame}
}
fn Polars::DataFrame::str_count_matches ($cols, $column, $pattern, $literal) {
    my %req = (frame => $cols, column => $column, pattern => $pattern)
    $req{literal} = $literal if defined $literal
    Polars::_decode("str_count_matches", polars__str_count_matches(to_json(\%req)))->{frame}
}
fn Polars::DataFrame::dt_timestamp ($cols, $column) {
    Polars::_decode("dt_timestamp", polars__dt_timestamp(to_json({ frame => $cols, column => $column })))->{frame}
}
fn Polars::DataFrame::dt_iso_year ($cols, $column) {
    Polars::_decode("dt_iso_year", polars__dt_iso_year(to_json({ frame => $cols, column => $column })))->{frame}
}

## `Series.dt.strftime(format)` — format datetime to string per chrono-style spec.
fn Polars::DataFrame::dt_strftime ($cols, $column, $format) {
    Polars::_decode("dt_strftime", polars__dt_strftime(to_json({ frame => $cols, column => $column, format => $format })))->{frame}
}

## `Series.str.zfill(length)` — pad with leading zeros to total `$length`.
fn Polars::DataFrame::str_zfill ($cols, $column, $length) {
    Polars::_decode("str_zfill", polars__str_zfill(to_json({ frame => $cols, column => $column, length => $length })))->{frame}
}

## Cast a single column to a new dtype. Supported: i64/f64/i32/f32/str/bool.
fn Polars::DataFrame::cast_column ($cols, $column, $dtype) {
    Polars::_decode("df_cast_column", polars__df_cast_column(to_json({ frame => $cols, column => $column, dtype => $dtype })))->{frame}
}

## Extend `$left` in place with `$right` (must share schema). Returns the
## combined frame.
fn Polars::DataFrame::extend ($left, $right) {
    Polars::_decode("df_extend", polars__df_extend(to_json({ frame => $left, right => $right })))->{frame}
}

## Add a 0-based (or `$offset`-based) row index as column `$name` (default "index").
fn Polars::DataFrame::with_row_index ($cols, $name, $offset) {
    my %req = (frame => $cols)
    $req{name} = $name if defined $name
    $req{offset} = $offset if defined $offset
    Polars::_decode("df_with_row_index", polars__df_with_row_index(to_json(\%req)))->{frame}
}

## Reverse the row order.
fn Polars::DataFrame::reverse ($cols) {
    Polars::_decode("df_reverse", polars__df_reverse(to_json({ frame => $cols })))->{frame}
}

## Distinct-value count for a single column.
fn Polars::DataFrame::n_unique ($cols, $column) {
    Polars::_decode("df_n_unique", polars__df_n_unique(to_json({ frame => $cols, column => $column })))->{n_unique}
}

## Null count per column (returns 1-row frame).
fn Polars::DataFrame::null_count ($cols) {
    Polars::_decode("df_null_count", polars__df_null_count(to_json({ frame => $cols })))->{frame}
}

## Exponentially weighted moving mean. `$alpha` defaults to 0.5.
fn Polars::DataFrame::ewm_mean ($cols, $alpha, $columns) {
    my %req = (frame => $cols)
    $req{alpha} = $alpha if defined $alpha
    $req{columns} = $columns if defined $columns
    Polars::_decode("df_ewm_mean", polars__df_ewm_mean(to_json(\%req)))->{frame}
}

# ── P1.5c: misc ─────────────────────────────────────────────────────

## Transpose (rows ↔ columns). Optional `$keep_names_as` retains original
## column names as the first transposed column.
fn Polars::DataFrame::transpose ($cols, $keep_names_as) {
    my %req = (frame => $cols)
    $req{keep_names_as} = $keep_names_as if defined $keep_names_as
    Polars::_decode("df_transpose", polars__df_transpose(to_json(\%req)))->{frame}
}

## Serialize to CSV (string). Optional `$sep` (default ',') and `$has_header`
## (default true).
fn Polars::DataFrame::to_csv ($cols, $sep, $has_header) {
    my %req = (frame => $cols)
    $req{sep} = $sep if defined $sep
    $req{has_header} = $has_header if defined $has_header
    Polars::_decode("df_to_csv", polars__df_to_csv(to_json(\%req)))->{csv}
}

## Serialize to NDJSON (one row per line). Returns the string.
fn Polars::DataFrame::to_ndjson ($cols) {
    Polars::_decode("df_to_ndjson", polars__df_to_ndjson(to_json({ frame => $cols })))->{json}
}

## Pearson correlation between columns `$x` and `$y`. Returns scalar f64.
fn Polars::DataFrame::pearson_corr ($cols, $x, $y) {
    Polars::_decode("df_pearson_corr", polars__df_pearson_corr(to_json({ frame => $cols, x => $x, y => $y })))->{corr}
}

## Rows where `$column` value is in `$values` arrayref.
fn Polars::DataFrame::filter_is_in ($cols, $column, $values) {
    Polars::_decode("df_filter_is_in", polars__df_filter_is_in(to_json({ frame => $cols, column => $column, values => $values })))->{frame}
}

## Top `$k` rows ordered descending by `$column`.
fn Polars::DataFrame::nlargest ($cols, $k, $column) {
    Polars::_decode("df_nlargest", polars__df_nlargest(to_json({ frame => $cols, k => $k, column => $column })))->{frame}
}

## Bottom `$k` rows ordered ascending by `$column`.
fn Polars::DataFrame::nsmallest ($cols, $k, $column) {
    Polars::_decode("df_nsmallest", polars__df_nsmallest(to_json({ frame => $cols, k => $k, column => $column })))->{frame}
}

## Random sample of `$n` rows. Optional `$seed` for reproducibility.
fn Polars::DataFrame::sample ($cols, $n, $seed) {
    my %req = (frame => $cols, n => $n)
    $req{seed} = $seed if defined $seed
    Polars::_decode("df_sample", polars__df_sample(to_json(\%req)))->{frame}
}

## In `$column`, replace literal `$from` with literal `$to`.
fn Polars::DataFrame::replace_value ($cols, $column, $from, $to) {
    Polars::_decode("df_replace_value", polars__df_replace_value(to_json({ frame => $cols, column => $column, from => $from, to => $to })))->{frame}
}
