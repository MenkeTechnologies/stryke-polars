## lib/Linalg.stk — `use Polars::Linalg`
##
## `np.linalg.*` surface (P5 slice). Backed by `nalgebra` on the cdylib side
## (pure-Rust, no BLAS link).
##
## Matrix wire format: 2-D `{ data, shape: [rows, cols] }` row-major.

package Polars::Linalg

use Polars

## Matrix inverse. Errors if singular.
fn Polars::Linalg::inv ($m) {
    Polars::_decode("linalg_inv", polars__linalg_inv(to_json({ matrix => $m })))->{matrix}
}

## Matrix determinant (scalar).
fn Polars::Linalg::det ($m) {
    Polars::_decode("linalg_det", polars__linalg_det(to_json({ matrix => $m })))->{scalar}
}

## Solve `A x = b` for x (returns 1-D array).
fn Polars::Linalg::solve ($A, $b) {
    Polars::_decode("linalg_solve", polars__linalg_solve(to_json({ matrix => $A, b => $b })))->{array}
}

## Frobenius / 2-norm (scalar).
fn Polars::Linalg::norm ($arr) {
    Polars::_decode("linalg_norm", polars__linalg_norm(to_json({ array => $arr })))->{scalar}
}

## Matrix trace (sum of diagonal). Square required.
fn Polars::Linalg::trace ($m) {
    Polars::_decode("linalg_trace", polars__linalg_trace(to_json({ matrix => $m })))->{scalar}
}

## Numerical rank (SVD with tol=1e-10).
fn Polars::Linalg::rank ($m) {
    Polars::_decode("linalg_rank", polars__linalg_rank(to_json({ matrix => $m })))->{rank}
}

1
