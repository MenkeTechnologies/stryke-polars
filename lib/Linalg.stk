## lib/Linalg.stk — `use Polars::Linalg`
##
## `np.linalg.*` surface (P5 slice). Backed by `nalgebra` on the cdylib side
## (pure-Rust, no BLAS link).
##
## Matrix wire format: 2-D `{ data, shape: [rows, cols] }` row-major.

package Polars::Linalg

use Polars

## Matrix inverse. Errors if singular.
fn Polars::Linalg::inv ($m) {
    Polars::_decode("linalg_inv", polars__linalg_inv(to_json({ matrix => $m })))->{matrix}
}

## Matrix determinant (scalar).
fn Polars::Linalg::det ($m) {
    Polars::_decode("linalg_det", polars__linalg_det(to_json({ matrix => $m })))->{scalar}
}

## Solve `A x = b` for x (returns 1-D array).
fn Polars::Linalg::solve ($A, $b) {
    Polars::_decode("linalg_solve", polars__linalg_solve(to_json({ matrix => $A, b => $b })))->{array}
}

## Frobenius / 2-norm (scalar).
fn Polars::Linalg::norm ($arr) {
    Polars::_decode("linalg_norm", polars__linalg_norm(to_json({ array => $arr })))->{scalar}
}

## Matrix trace (sum of diagonal). Square required.
fn Polars::Linalg::trace ($m) {
    Polars::_decode("linalg_trace", polars__linalg_trace(to_json({ matrix => $m })))->{scalar}
}

## Numerical rank (SVD with tol=1e-10).
fn Polars::Linalg::rank ($m) {
    Polars::_decode("linalg_rank", polars__linalg_rank(to_json({ matrix => $m })))->{rank}
}

## Matrix multiplication `A @ B` (both 2-D).
fn Polars::Linalg::matmul ($A, $B) {
    Polars::_decode("linalg_matmul", polars__linalg_matmul(to_json({ a => $A, b => $B })))->{matrix}
}

## Singular values (descending, 1-D array).
fn Polars::Linalg::singular_values ($m) {
    Polars::_decode("linalg_singular_values", polars__linalg_singular_values(to_json({ matrix => $m })))->{array}
}

## LU decomposition. Returns `{ l, u }` (no permutation tracking).
fn Polars::Linalg::lu ($m) {
    Polars::_decode("linalg_lu", polars__linalg_lu(to_json({ matrix => $m })))
}
## QR decomposition. Returns `{ q, r }`.
fn Polars::Linalg::qr ($m) {
    Polars::_decode("linalg_qr", polars__linalg_qr(to_json({ matrix => $m })))
}
## Matrix power `A^k` (k ≥ 0).
fn Polars::Linalg::matrix_power ($m, $k) {
    Polars::_decode("linalg_matrix_power", polars__linalg_matrix_power(to_json({ matrix => $m, k => $k })))->{matrix}
}

## Outer product `a ⊗ b` of two 1-D vectors → 2-D matrix.
fn Polars::Linalg::outer ($a, $b) {
    Polars::_decode("linalg_outer", polars__linalg_outer(to_json({ a => $a, b => $b })))->{array}
}

## Diagonal vector of a square matrix.
fn Polars::Linalg::diag ($m) {
    Polars::_decode("linalg_diag", polars__linalg_diag(to_json({ matrix => $m })))->{array}
}

## Cholesky decomposition (lower-triangular L). Requires SPD matrix.
fn Polars::Linalg::cholesky ($m) {
    Polars::_decode("linalg_cholesky", polars__linalg_cholesky(to_json({ matrix => $m })))->{matrix}
}

## Moore-Penrose pseudoinverse (SVD-based).
fn Polars::Linalg::pinv ($m) {
    Polars::_decode("linalg_pinv", polars__linalg_pinv(to_json({ matrix => $m })))->{matrix}
}

## Kronecker product of two matrices.
fn Polars::Linalg::kron ($a, $b) {
    Polars::_decode("linalg_kron", polars__linalg_kron(to_json({ a => $a, b => $b })))->{matrix}
}

## Real eigenvalues of a symmetric matrix (descending).
fn Polars::Linalg::eigvalsh ($m) {
    Polars::_decode("linalg_eigvalsh", polars__linalg_eigvalsh(to_json({ matrix => $m })))->{array}
}

1
