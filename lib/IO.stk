## lib/IO.stk — `use Polars::IO`
##
## Wrappers around the cdylib `polars__*` exports for the `pd_*` family.
## Auto-generated from src/*.rs sources — args, return keys, and docstrings
## come straight from the Rust definitions.

package Polars::IO

use Polars

## pandas IO concat.
fn Polars::IO::concat ($frames) {
    Polars::_decode("pd_concat", polars__pd_concat(to_json({ frames => $frames })))->{frame}
}

## pandas IO from records.
fn Polars::IO::from_records ($records) {
    Polars::_decode("pd_from_records", polars__pd_from_records(to_json({ records => $records })))->{frame}
}

## pandas IO merge.
fn Polars::IO::merge ($left, $right, $on) {
    Polars::_decode("pd_merge", polars__pd_merge(to_json({ left => $left, right => $right, on => $on })))->{frame}
}

## pandas IO read arrow.
fn Polars::IO::read_arrow () {
    val %req = ()
    Polars::_decode("pd_read_arrow", polars__pd_read_arrow(to_json(\%req)))
}

## pandas IO read csv.
fn Polars::IO::read_csv ($path, $header, $sep) {
    var %req = (path => $path)
    $req{header} = $header if defined $header
    $req{sep} = $sep if defined $sep
    Polars::_decode("pd_read_csv", polars__pd_read_csv(to_json(\%req)))->{frame}
}

