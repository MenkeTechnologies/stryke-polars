## lib/FFT.stk — `use Polars::FFT`
##
## `np.fft.*` surface (P5 slice). Backed by `rustfft` on the cdylib side.
##
## Forward FFT: real 1-D array → complex `{ real, imag, shape }`.
## Inverse FFT: complex `{ real, imag, shape }` → real 1-D array
## (drops imag part; rustfft does not normalize so the cdylib divides by n).

package Polars::FFT

use Polars

## Forward FFT (1-D).
fn Polars::FFT::fft ($arr) {
    Polars::_decode("fft_fft", polars__fft_fft(to_json({ array => $arr })))->{complex}
}

## Inverse FFT (1-D).
fn Polars::FFT::ifft ($cplx) {
    Polars::_decode("fft_ifft", polars__fft_ifft(to_json({ complex => $cplx })))->{array}
}

## DFT sample frequencies (`np.fft.fftfreq(n, d=1.0)`). Returns 1-D array.
fn Polars::FFT::fftfreq ($n, $d) {
    my %req = (n => $n)
    $req{d} = $d if defined $d
    Polars::_decode("fft_fftfreq", polars__fft_fftfreq(to_json(\%req)))->{array}
}

## Real FFT (positive half of spectrum only). Returns `{ real, imag, shape: [n/2+1] }`.
fn Polars::FFT::rfft ($arr) {
    Polars::_decode("fft_rfft", polars__fft_rfft(to_json({ array => $arr })))->{complex}
}

## `np.fft.fftshift(x)` — swap halves of a 1-D array.
fn Polars::FFT::fftshift ($arr) {
    Polars::_decode("fft_fftshift", polars__fft_fftshift(to_json({ array => $arr })))->{array}
}

## Inverse real FFT. `$cplx` is `{real, imag, shape: [n/2+1]}`; `$n` is the
## original signal length.
fn Polars::FFT::irfft ($cplx, $n) {
    Polars::_decode("fft_irfft", polars__fft_irfft(to_json({ complex => $cplx, n => $n })))->{array}
}

## Inverse of `fftshift` (coincides for even-n arrays, differs for odd).
fn Polars::FFT::ifftshift ($arr) {
    Polars::_decode("fft_ifftshift", polars__fft_ifftshift(to_json({ array => $arr })))->{array}
}

1
