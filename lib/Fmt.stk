## Format human bytes.
fn Polars::Fmt::human_bytes ($bytes) {
    Polars::_decode("fmt_human_bytes", polars__fmt_human_bytes(to_json({ bytes => $bytes })))->{formatted}
}

## Format a plain count compactly with base-1000 SI suffixes (K/M/B/T) — distinct
## from human_bytes (base-1024 byte sizes). 1500 -> "1.5K", 2_000_000 -> "2M",
## -2500 -> "-2.5K", 999 -> "999". Trailing zeros trimmed (1000 -> "1K"); rounding
## that reaches 1000 rolls up (999_999 -> "1M"). $precision = mantissa decimals
## (default 1). Returns the formatted string.
fn Polars::Fmt::human_count ($n, $precision = 1) {
    Polars::_decode("fmt_human_count", polars__fmt_human_count(to_json({ n => $n, precision => $precision })))->{formatted}
}

## Parse a human byte size back to a count — inverse of human_bytes. Splits the
## number from a unit suffix (B/KB/MB/GB/TB/PB, base 1024, case-insensitive; bare
## K/M/… and KiB/MiB also accepted). parse_bytes("1.5 MB") → 1572864.
fn Polars::Fmt::parse_bytes ($value) {
    Polars::_decode("fmt_parse_bytes", polars__fmt_parse_bytes(to_json({ value => $value })))->{bytes}
}

## Parse a compact count back to a number — inverse of human_count. Splits the
## number from a base-1000 SI suffix (K/M/B/T, case-insensitive; bare number = a
## plain count), distinct from parse_bytes' base-1024. Whole result → integer,
## fractional → float. parse_count("1.5K") → 1500, parse_count("2M") → 2000000.
fn Polars::Fmt::parse_count ($value) {
    Polars::_decode("fmt_parse_count", polars__fmt_parse_count(to_json({ value => $value })))->{count}
}

## Format human duration.
fn Polars::Fmt::human_duration ($seconds) {
    Polars::_decode("fmt_human_duration", polars__fmt_human_duration(to_json({ seconds => $seconds })))->{formatted}
}

## Parse a human duration string back to seconds — the inverse of human_duration.
## A duration is a run of <number><unit> components (whitespace optional); units
## are d/day(s) (86400), h/hr/hour(s) (3600), m/min/minute(s) (60),
## s/sec/second(s) (1) and ms (0.001), summed. A bare trailing number is taken as
## seconds. parse_duration("1h 30m 0s") → 5400, round-tripping human_duration.
fn Polars::Fmt::parse_duration ($value) {
    Polars::_decode("fmt_parse_duration", polars__fmt_parse_duration(to_json({ value => $value })))->{seconds}
}

