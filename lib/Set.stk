}

## Set is equal — true when $a and $b have the same distinct elements, ignoring
## order and multiplicity (mutual subset). Companion of is_subset/is_superset.
fn Polars::Set::is_equal ($a, $b) {
    Polars::_decode("set_is_equal", polars__set_is_equal(to_json({ a => $a, b => $b })))->{is_equal}
}

