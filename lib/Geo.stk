## Geometric rotate.
fn Polars::Geo::rotate ($x, $y, $angle, $cx, $cy) {
    var %req = (x => $x, y => $y, angle => $angle)
    $req{cx} = $cx if defined $cx
    $req{cy} = $cy if defined $cy
    Polars::_decode("geo_rotate", polars__geo_rotate(to_json(\%req)))->{x}
}

