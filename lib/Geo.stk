package Polars::Geo

use Polars

## Geometric bbox.
fn Polars::Geo::bbox ($x, $y) {
    Polars::_decode("geo_bbox", polars__geo_bbox(to_json({ x => $x, y => $y })))->{x_min}
}

## Geometric bearing.
fn Polars::Geo::bearing ($lat1, $lon1, $lat2, $lon2) {
    Polars::_decode("geo_bearing", polars__geo_bearing(to_json({ lat1 => $lat1, lon1 => $lon1, lat2 => $lat2, lon2 => $lon2 })))->{bearing}
}

