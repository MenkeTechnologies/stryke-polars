## Geometric haversine.
fn Polars::Geo::haversine ($lat1, $lon1, $lat2, $lon2, $radius) {
    var %req = (lat1 => $lat1, lon1 => $lon1, lat2 => $lat2, lon2 => $lon2)
    $req{radius} = $radius if defined $radius
    Polars::_decode("geo_haversine", polars__geo_haversine(to_json(\%req)))->{distance}
