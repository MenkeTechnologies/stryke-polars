package Polars::Dist

use Polars

## Beta cdf.
fn Polars::Dist::beta_cdf ($x, $a, $b) {
    Polars::_decode("dist_beta_cdf", polars__dist_beta_cdf(to_json({ x => $x, a => $a, b => $b })))->{cdf}
}

## Beta pdf.
fn Polars::Dist::beta_pdf ($x, $a, $b) {
    Polars::_decode("dist_beta_pdf", polars__dist_beta_pdf(to_json({ x => $x, a => $a, b => $b })))->{pdf}
}

