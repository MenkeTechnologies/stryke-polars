## lib/Random.stk — `use Polars::Random`
##
## Random sampling (P5 slice). Backed by `rand_distr` + `rand_chacha`
## (seeded ChaCha8) on the cdylib side. Output: 1-D `{ data, shape }`.

package Polars::Random

use Polars

## `np.random.normal(mean, std, n)` — n samples from Normal(mean, std).
fn Polars::Random::normal ($n, $mean, $std, $seed) {
    my %req = (n => $n)
    $req{mean} = $mean if defined $mean
    $req{std} = $std if defined $std
    $req{seed} = $seed if defined $seed
    Polars::_decode("rand_normal", polars__rand_normal(to_json(\%req)))->{array}
}

## `np.random.uniform(low, high, n)`.
fn Polars::Random::uniform ($n, $low, $high, $seed) {
    my %req = (n => $n)
    $req{low} = $low if defined $low
    $req{high} = $high if defined $high
    $req{seed} = $seed if defined $seed
    Polars::_decode("rand_uniform", polars__rand_uniform(to_json(\%req)))->{array}
}

## `np.random.exponential(scale, n)`.
fn Polars::Random::exponential ($n, $scale, $seed) {
    my %req = (n => $n)
    $req{scale} = $scale if defined $scale
    $req{seed} = $seed if defined $seed
    Polars::_decode("rand_exponential", polars__rand_exponential(to_json(\%req)))->{array}
}

## `np.random.beta(alpha, beta, n)`.
fn Polars::Random::beta ($n, $alpha, $beta, $seed) {
    my %req = (n => $n, alpha => $alpha, beta => $beta)
    $req{seed} = $seed if defined $seed
    Polars::_decode("rand_beta", polars__rand_beta(to_json(\%req)))->{array}
}

## `np.random.gamma(shape, scale, n)`.
fn Polars::Random::gamma ($n, $shape, $scale, $seed) {
    my %req = (n => $n, shape => $shape)
    $req{scale} = $scale if defined $scale
    $req{seed} = $seed if defined $seed
    Polars::_decode("rand_gamma", polars__rand_gamma(to_json(\%req)))->{array}
}

## Sample without replacement: `$k` distinct values from `$arr`.
fn Polars::Random::choice ($arr, $k, $seed) {
    my %req = (array => $arr, k => $k)
    $req{seed} = $seed if defined $seed
    Polars::_decode("rand_choice", polars__rand_choice(to_json(\%req)))->{array}
}

1
