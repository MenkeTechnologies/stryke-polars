package Polars::Metric

use Polars

## ML metric accuracy.
fn Polars::Metric::accuracy ($y_true, $y_pred) {
    Polars::_decode("metric_accuracy", polars__metric_accuracy(to_json({ y_true => $y_true, y_pred => $y_pred })))->{accuracy}
}

