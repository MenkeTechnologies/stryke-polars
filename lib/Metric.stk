## ML metric confusion matrix.
fn Polars::Metric::confusion_matrix ($y_true, $y_pred, $n_classes) {
    my %req = (y_true => $y_true, y_pred => $y_pred)
    $req{n_classes} = $n_classes if defined $n_classes
    Polars::_decode("metric_confusion_matrix", polars__metric_confusion_matrix(to_json(\%req)))->{confusion_matrix}
}

