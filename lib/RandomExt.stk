## lib/RandomExt.stk — `use Polars::RandomExt`
##
## Wrappers around the cdylib `polars__*` exports for the `rand_*` family.
## Auto-generated from src/*.rs sources — args, return keys, and docstrings
## come straight from the Rust definitions.

package Polars::RandomExt

use Polars

## Random bernoulli.
fn Polars::RandomExt::bernoulli ($n, $p) {
    Polars::_decode("rand_bernoulli", polars__rand_bernoulli(to_json({ n => $n, p => $p })))->{array}
}

## Random beta v2.
fn Polars::RandomExt::beta_v2 ($n, $alpha, $beta) {
    Polars::_decode("rand_beta_v2", polars__rand_beta_v2(to_json({ n => $n, alpha => $alpha, beta => $beta })))->{array}
}

## Random cauchy v2.
fn Polars::RandomExt::cauchy_v2 ($n, $mu, $scale) {
    my %req = (n => $n)
    $req{mu} = $mu if defined $mu
    $req{scale} = $scale if defined $scale
    Polars::_decode("rand_cauchy_v2", polars__rand_cauchy_v2(to_json(\%req)))->{array}
}

