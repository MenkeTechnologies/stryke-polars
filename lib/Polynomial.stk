## lib/Polynomial.stk — `use Polars::Polynomial`
##
## `np.polynomial.*` surface (P5 slice). Hand-rolled on `ndarray` (recurrence
## formulas). Wire format: coefficient list + 1-D x-array.

package Polars::Polynomial

use Polars

## Evaluate polynomial `c0 + c1*x + c2*x^2 + ...` at each point in `$x`
## (an ndarray `{data, shape}`). Uses Horner's method on the cdylib side.
fn Polars::Polynomial::polyval ($coefficients, $x) {
    Polars::_decode("poly_polyval", polars__poly_polyval(to_json({ coefficients => $coefficients, x => $x })))->{array}
}

## Derivative coefficients: `[c0, c1, c2, ...]` → `[c1, 2c2, 3c3, ...]`.
fn Polars::Polynomial::polyder ($coefficients) {
    Polars::_decode("poly_polyder", polars__poly_polyder(to_json({ coefficients => $coefficients })))->{coefficients}
}

## Integral coefficients: `[c0, c1, ...]` → `[c0_int, c0, c1/2, c2/3, ...]`.
## `$c0_int` is the integration constant (default 0).
fn Polars::Polynomial::polyint ($coefficients, $c0) {
    my %req = (coefficients => $coefficients)
    $req{c0} = $c0 if defined $c0
    Polars::_decode("poly_polyint", polars__poly_polyint(to_json(\%req)))->{coefficients}
}

## Least-squares polynomial fit. `$x` and `$y` are 1-D arrays. Returns
## coefficients ordered low-to-high (c0 + c1*x + c2*x^2 + ...).
fn Polars::Polynomial::polyfit ($x, $y, $deg) {
    Polars::_decode("poly_polyfit", polars__poly_polyfit(to_json({ x => $x, y => $y, deg => $deg })))->{coefficients}
}

1
