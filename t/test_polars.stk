## t/test_polars.stk — assertion tests for the stryke `Polars` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`). Hand-rolled
## TAP via `p "ok $i"` doesn't count toward the runner's assertion total —
## only registered `assert_*` calls do. Test count below ≈ assertion count.
##
## Requires the cdylib to be installed so `use Polars` can `dlopen` it:
##
##   cargo build --release
##   s pkg install -g .
##   s test t/
##
## If the cdylib isn't loaded we surface a single hard failure rather than
## silently SKIP — the goal here is to actually exercise the FFI surface.

use Polars
use Polars::DataFrame
use Polars::Series
use Polars::NdArray
use Polars::Ufunc

# ══════════════════════════════════════════════════════════════════
# version smoke
# ══════════════════════════════════════════════════════════════════

val $v = Polars::version()
assert_ok ref($v) eq "HASH", "Polars::version returns a hash"
assert_ok defined($v->{version}) && length($v->{version}) > 0, "version.version is non-empty"
assert_ok defined($v->{polars})  && length($v->{polars})  > 0, "version.polars is non-empty"
assert_ok defined($v->{ndarray}) && length($v->{ndarray}) > 0, "version.ndarray is non-empty"

# ══════════════════════════════════════════════════════════════════
# DataFrame round-trip (the original P1 surface)
# ══════════════════════════════════════════════════════════════════

val %frame = (
    id    => [1, 2, 3, 4, 5],
    score => [1.5, 2.0, 3.25, 4.0, 5.5],
    name  => ["alice", "bob", "charlie", "dana", "eve"],
)

val $r = Polars::DataFrame::new(\%frame)
assert_eq $r->{shape}[0], 5, "df_new shape rows == 5"
assert_eq $r->{shape}[1], 3, "df_new shape cols == 3"

val $shape = Polars::DataFrame::shape(\%frame)
assert_eq $shape->[0], 5, "df_shape rows == 5"
assert_eq $shape->[1], 3, "df_shape cols == 3"

val $columns = Polars::DataFrame::columns(\%frame)
assert_eq scalar(@$columns), 3, "df_columns returns 3 names"

val $dtypes = Polars::DataFrame::dtypes(\%frame)
assert_eq scalar(@$dtypes), 3, "df_dtypes returns 3 dtypes"

val $head = Polars::DataFrame::head(\%frame, 2)
assert_eq scalar(@{$head->{id}}), 2, "df_head(2) → 2 rows"

val $tail = Polars::DataFrame::tail(\%frame, 2)
assert_eq scalar(@{$tail->{id}}), 2, "df_tail(2) → 2 rows"

val $sel = Polars::DataFrame::select(\%frame, ["id", "score"])
assert_ok  exists $sel->{id},     "df_select keeps id"
assert_ok  exists $sel->{score},  "df_select keeps score"
assert_ok !exists $sel->{name},   "df_select drops name"

val $rt = Polars::DataFrame::to_json(\%frame)
assert_eq scalar(@{$rt->{id}}), 5, "df_to_json round-trip preserves all 5 rows"
assert_eq $rt->{id}[0], 1, "df_to_json round-trip preserves id[0] == 1"
assert_eq $rt->{id}[4], 5, "df_to_json round-trip preserves id[4] == 5"

val $dropped = Polars::DataFrame::drop(\%frame, ["name"])
assert_ok !exists $dropped->{name}, "df_drop removed name"

val $renamed = Polars::DataFrame::rename(\%frame, { id => "uid" })
assert_ok  exists $renamed->{uid}, "df_rename added uid"
assert_ok !exists $renamed->{id},  "df_rename dropped id"

# Sort ascending (default) — top row is the smallest score. desc=true requires
# a JSON boolean which the stryke→Rust bridge currently surfaces as a number,
# so we stick to the default ordering here and let the Rust unit tests cover
# the descending path.
val $sorted = Polars::DataFrame::sort(\%frame, ["score"])
assert_eq $sorted->{score}[0], 1.5, "df_sort score asc → top == 1.5 (smallest)"
assert_eq $sorted->{score}[4], 5.5, "df_sort score asc → bottom == 5.5 (largest)"

val $gt = Polars::DataFrame::filter_gt(\%frame, "score", 3.0)
assert_eq scalar(@{$gt->{score}}), 3, "df_filter_gt score > 3.0 → 3 rows"

val $lt = Polars::DataFrame::filter_lt(\%frame, "id", 3)
assert_eq scalar(@{$lt->{id}}), 2, "df_filter_lt id < 3 → 2 rows"

val $eqf = Polars::DataFrame::filter_eq(\%frame, "name", "bob")
assert_eq scalar(@{$eqf->{name}}), 1, "df_filter_eq name == bob → 1 row"

val $sum = Polars::DataFrame::sum(\%frame)
assert_eq $sum->{id}[0], 15, "df_sum id == 1+2+3+4+5 = 15"

val $mean = Polars::DataFrame::mean(\%frame)
assert_near $mean->{id}[0], 3.0, 1e-9, "df_mean id == 3.0"

val $mn = Polars::DataFrame::min(\%frame)
assert_eq $mn->{id}[0], 1, "df_min id == 1"

val $nu = Polars::DataFrame::nunique(\%frame)
assert_eq $nu->{id}, 5, "df_nunique id == 5 distinct values"

val $cs = Polars::DataFrame::cumsum(\%frame, ["id"])
assert_eq $cs->{id}[0], 1,  "df_cumsum id[0] == 1"
assert_eq $cs->{id}[4], 15, "df_cumsum id[4] == 1+2+3+4+5 = 15"

val $abs = Polars::DataFrame::abs(\%frame, ["score"])
assert_eq $abs->{score}[0], 1.5, "df_abs round-trips positive values"

# ══════════════════════════════════════════════════════════════════
# Series — P5 surface
# ══════════════════════════════════════════════════════════════════

val %s = (data => [1, 2, 3, 4, 5])

val $smean = polars__sr_mean(to_json({series => \%s}))
val $sm = from_json($smean)
assert_near $sm->{mean}, 3.0, 1e-12, "sr_mean([1..5]) == 3.0"

val $ssum = polars__sr_sum(to_json({series => \%s}))
val $ss = from_json($ssum)
assert_eq $ss->{sum}, 15, "sr_sum([1..5]) == 15"

val $smed = polars__sr_median(to_json({series => \%s}))
val $sme = from_json($smed)
assert_eq $sme->{median}, 3, "sr_median([1..5]) == 3"

val $scs = polars__sr_cumsum(to_json({series => \%s}))
val $scumsum = from_json($scs)
assert_eq $scumsum->{series}{data}[4], 15, "sr_cumsum last == 15"
assert_eq $scumsum->{series}{data}[0], 1,  "sr_cumsum first == 1"

# ══════════════════════════════════════════════════════════════════
# numpy ndarray + ufuncs
# ══════════════════════════════════════════════════════════════════

val $zeros = Polars::NdArray::zeros([3])
assert_eq scalar(@{$zeros->{data}}), 3, "arr_zeros([3]) length == 3"
assert_eq $zeros->{data}[0], 0, "arr_zeros([3])[0] == 0"

val $ones = Polars::NdArray::ones([4])
assert_eq scalar(@{$ones->{data}}), 4, "arr_ones([4]) length == 4"
assert_eq $ones->{data}[3], 1, "arr_ones([4])[3] == 1"

val $rng = Polars::NdArray::arange(0, 5)
assert_eq scalar(@{$rng->{data}}), 5, "arr_arange(0,5) length == 5"
assert_eq $rng->{data}[0], 0, "arr_arange starts at 0"
assert_eq $rng->{data}[4], 4, "arr_arange last == 4 (stop-exclusive)"

# Trigonometric round-trip: sin(0) = 0, cos(0) = 1.
val %z = (data => [0.0], shape => [1])
val $sin0 = polars__np_sin(to_json({array => \%z}))
val $sin0_r = from_json($sin0)
assert_near $sin0_r->{array}{data}[0], 0.0, 1e-12, "np_sin(0) == 0"

val $cos0 = polars__np_cos(to_json({array => \%z}))
val $cos0_r = from_json($cos0)
assert_near $cos0_r->{array}{data}[0], 1.0, 1e-12, "np_cos(0) == 1"

# ══════════════════════════════════════════════════════════════════
# Math primitives — exercise the scipy-class extension layer
# ══════════════════════════════════════════════════════════════════

# misc_is_prime — primes, composites, edge cases. JSON bool decodes to a
# stryke truthy value, so use assert_ok / assert_false for boolean shape.
assert_ok    from_json(polars__misc_is_prime(to_json({n => 17})))->{is_prime}, "is_prime(17) true"
assert_ok    from_json(polars__misc_is_prime(to_json({n => 2 })))->{is_prime}, "is_prime(2)  true (only even prime)"
assert_false from_json(polars__misc_is_prime(to_json({n => 1 })))->{is_prime}, "is_prime(1)  false"
assert_false from_json(polars__misc_is_prime(to_json({n => 25})))->{is_prime}, "is_prime(25) false (5*5)"

# misc_factorial — known table values
assert_eq from_json(polars__misc_factorial(to_json({n => 5 })))->{factorial}, 120,    "factorial(5)  == 120"
assert_eq from_json(polars__misc_factorial(to_json({n => 10})))->{factorial}, 3628800, "factorial(10) == 3,628,800"

# misc_fibonacci — F(10) = 55
assert_eq from_json(polars__misc_fibonacci(to_json({n => 10})))->{value}, 55, "F(10) == 55"

# misc_gcd / misc_lcm — identity gcd * lcm == a * b
val $g = from_json(polars__misc_gcd(to_json({a => 12, b => 18})))->{gcd}
val $l = from_json(polars__misc_lcm(to_json({a => 12, b => 18})))->{lcm}
assert_eq $g, 6,  "gcd(12, 18) == 6"
assert_eq $l, 36, "lcm(12, 18) == 36"
assert_eq $g * $l, 12 * 18, "gcd * lcm == a * b identity"

# ══════════════════════════════════════════════════════════════════
# Format helpers — Roman, ordinal, binary
# ══════════════════════════════════════════════════════════════════

assert_eq from_json(polars__fmt_roman(to_json({n => 2024})))->{roman}, "MMXXIV",  "roman(2024)  == MMXXIV"
assert_eq from_json(polars__fmt_roman(to_json({n => 1994})))->{roman}, "MCMXCIV", "roman(1994)  == MCMXCIV"
assert_eq from_json(polars__fmt_roman(to_json({n => 4   })))->{roman}, "IV",      "roman(4)     == IV (subtractive)"

assert_eq from_json(polars__fmt_ordinal(to_json({n => 1 })))->{ordinal}, "1st",   "ordinal(1)   == 1st"
assert_eq from_json(polars__fmt_ordinal(to_json({n => 11})))->{ordinal}, "11th",  "ordinal(11)  == 11th (teen carve-out)"
assert_eq from_json(polars__fmt_ordinal(to_json({n => 22})))->{ordinal}, "22nd",  "ordinal(22)  == 22nd"

# ══════════════════════════════════════════════════════════════════
# Hashes — known RFC test vectors
# ══════════════════════════════════════════════════════════════════

# CRC-32 of "123456789" is 0xCBF43926 == 3,421,780,262 — universal CRC32 vector.
assert_eq from_json(polars__hash_crc32(to_json({value => "123456789"})))->{hash}, 3421780262, "CRC32('123456789') == 0xCBF43926"

# djb2 seed: hash("") == 5381.
assert_eq from_json(polars__hash_djb2(to_json({value => ""})))->{hash}, 5381, "djb2('') == 5381 (initial seed)"

# Adler-32("Wikipedia") == 0x11E60398 == 300,286,872 — RFC 1950 vector.
assert_eq from_json(polars__sum_adler32(to_json({value => "Wikipedia"})))->{checksum}, 300286872, "Adler32('Wikipedia') == 0x11E60398"

# ══════════════════════════════════════════════════════════════════
# Distances + ML metrics
# ══════════════════════════════════════════════════════════════════

# Euclidean(0,0)→(3,4) = 5 — Pythagorean.
val $ed = from_json(polars__dist_euclidean(to_json({a => [0.0, 0.0], b => [3.0, 4.0]})))->{distance}
assert_near $ed, 5.0, 1e-12, "euclidean (0,0)→(3,4) == 5 (Pythagorean)"

# Accuracy of 4/5 matches == 0.8.
val $acc = from_json(polars__metric_accuracy(to_json({y_true => [1, 0, 1, 1, 0], y_pred => [1, 0, 1, 0, 0]})))->{accuracy}
assert_near $acc, 0.8, 1e-12, "metric_accuracy 4/5 == 0.8"

# Levenshtein(kitten, sitting) = 3 — Wikipedia canonical example.
assert_eq from_json(polars__text_levenshtein(to_json({a => "kitten", b => "sitting"})))->{levenshtein}, 3, "Levenshtein(kitten, sitting) == 3"

# ══════════════════════════════════════════════════════════════════
# datetime64 — Gregorian leap-year rule
# ══════════════════════════════════════════════════════════════════

val $leap = from_json(polars__dt64_is_leap_year(to_json({values => ["2000-01-01", "1900-01-01", "2024-01-01", "2023-01-01"]})))->{is_leap_year}
# JSON bool decodes to a stryke truthy value — use assert_ok / assert_false
# for boolean shape rather than `assert_eq … true` (string mismatch).
assert_ok    $leap->[0], "2000 leap (divisible by 400)"
assert_false $leap->[1], "1900 not leap (divisible by 100 but not 400)"
assert_ok    $leap->[2], "2024 leap"
assert_false $leap->[3], "2023 not leap"

# Quarter partition
val $q = from_json(polars__dt64_quarter(to_json({values => ["2024-01-15", "2024-04-15", "2024-07-15", "2024-10-15"]})))->{quarter}
assert_eq $q->[0], 1, "Jan → Q1"
assert_eq $q->[1], 2, "Apr → Q2"
assert_eq $q->[2], 3, "Jul → Q3"
assert_eq $q->[3], 4, "Oct → Q4"

# ══════════════════════════════════════════════════════════════════
# Bit manipulation
# ══════════════════════════════════════════════════════════════════

assert_eq from_json(polars__bit_popcount(to_json({x => 7    })))->{popcount}, 3, "popcount(7)   == 3"
assert_eq from_json(polars__bit_popcount(to_json({x => 255  })))->{popcount}, 8, "popcount(255) == 8"
assert_eq from_json(polars__bit_popcount(to_json({x => 0    })))->{popcount}, 0, "popcount(0)   == 0"

# set + clear is identity
val $bset = from_json(polars__bit_set(to_json({x => 0, n => 3})))->{set}
assert_eq $bset, 8, "bit_set(0, 3) == 8 (1 << 3)"
val $bclr = from_json(polars__bit_clear(to_json({x => 8, n => 3})))->{clear}
assert_eq $bclr, 0, "bit_clear(8, 3) == 0 (set + clear = identity)"

# ── pure helper: parse_dtype (no frame) ────────────────────────────
val $di = Polars::DataFrame::parse_dtype("int")
assert_eq $di->{canonical}, "Int64",  "parse_dtype: int → Int64"
assert_eq $di->{numeric},   1,         "parse_dtype: Int64 is numeric"
assert_eq $di->{integer},   1,         "parse_dtype: Int64 is integer"
assert_eq $di->{signed},    1,         "parse_dtype: Int64 is signed"
val $du = Polars::DataFrame::parse_dtype("u32")
assert_eq $du->{canonical}, "UInt32",  "parse_dtype: u32 → UInt32"
assert_eq $du->{signed},    0,         "parse_dtype: UInt32 is unsigned"
val $ds = Polars::DataFrame::parse_dtype("utf8")
assert_eq $ds->{canonical}, "String",  "parse_dtype: utf8 → String"
assert_eq $ds->{numeric},   0,         "parse_dtype: String is not numeric"
val $dt = Polars::DataFrame::parse_dtype("datetime")
assert_eq $dt->{temporal},  1,         "parse_dtype: Datetime is temporal"

# ── Sparse::sub — subtract two sparse matrices, cancelled cells drop ──
use Polars::Sparse
# Native sparse form: { data, rows, cols, n_rows, n_cols }.
# A = [[5,0],[0,3]], B = [[1,0],[0,3]]  →  A-B = [[4,0],[0,0]]
val $sa = { data => [5, 3], rows => [0, 1], cols => [0, 1], n_rows => 2, n_cols => 2 }
val $sb = { data => [1, 3], rows => [0, 1], cols => [0, 1], n_rows => 2, n_cols => 2 }
val $sd = Polars::Sparse::sub($sa, $sb)
assert_eq Polars::Sparse::nnz($sd), 1,  "Sparse::sub: cancelled (1,1) entry dropped → 1 nonzero"
val $dense = Polars::Sparse::to_dense($sd)
assert_eq $dense->{data}[0], 4, "Sparse::sub: (0,0) = 5 - 1 = 4"
assert_eq $dense->{data}[3], 0, "Sparse::sub: (1,1) cancelled to 0"

# ── Sparse::mat_mul — sparse matrix product matches the dense result ──
# A = [[1,2],[0,3]], B = [[4,0],[1,5]]  →  A.B = [[6,10],[3,15]]
val $ma = { data => [1, 2, 3], rows => [0, 0, 1], cols => [0, 1, 1], n_rows => 2, n_cols => 2 }
val $mb = { data => [4, 1, 5], rows => [0, 1, 1], cols => [0, 0, 1], n_rows => 2, n_cols => 2 }
val $prod = Polars::Sparse::to_dense(Polars::Sparse::mat_mul($ma, $mb))
assert_eq $prod->{data}[0], 6,  "Sparse::mat_mul: (0,0) = 1*4 + 2*1 = 6"
assert_eq $prod->{data}[1], 10, "Sparse::mat_mul: (0,1) = 2*5 = 10"
assert_eq $prod->{data}[2], 3,  "Sparse::mat_mul: (1,0) = 3*1 = 3"
assert_eq $prod->{data}[3], 15, "Sparse::mat_mul: (1,1) = 3*5 = 15"

# ══════════════════════════════════════════════════════════════════
# Run all collected assertions and report.
# ══════════════════════════════════════════════════════════════════

test_run
